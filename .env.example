# Ollama Service Configuration
LOGTRIAGE_OLLAMA_HOST=http://127.0.0.1:11434
LOGTRIAGE_OLLAMA_MODEL=gemma4:e2b
LOGTRIAGE_OLLAMA_TIMEOUT_SECONDS=15.0
LOGTRIAGE_OLLAMA_MAX_RETRIES=2
LOGTRIAGE_OLLAMA_BACKOFF_FACTOR=1.5

# Aggregation & Processing
LOGTRIAGE_SLIDING_WINDOW_SECONDS=30.0
LOGTRIAGE_COOLDOWN_SECONDS=60.0
LOGTRIAGE_MAX_GROUPS=5000
LOGTRIAGE_MAX_QUEUE_SIZE=1000
LOGTRIAGE_MAX_CONTEXT_LINES=20
LOGTRIAGE_MAX_TOKEN_BUDGET=512

# Redaction & Privacy
LOGTRIAGE_REDACTION_ENABLED=true

# Output & Logging
LOGTRIAGE_OUTPUT_FORMAT=console
LOGTRIAGE_LOG_LEVEL=INFO
# LOGTRIAGE_STORAGE_PATH=./alerts.db
